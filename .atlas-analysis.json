  "keyFeatures": [
    "Product inventory management with barcode support",
    "Sales registration (single and bulk) with payment method tracking",
    "Real-time low-stock and expiration alerts via SSE notifications",
    "Business analytics dashboard with KPIs, charts, and heatmaps",
    "CSV product import",
    "Role-based access control (root, admin, vendor)",
    "Full audit log for all entity changes",
    "User registration approval workflow",
    "PyWebView desktop wrapper (runs as a native desktop app)",
    "Password reset via email with 6-digit verification codes"
  ],
